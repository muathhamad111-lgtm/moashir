{
  "name": "muasher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "icons:pro": "npm install --no-save --no-audit --no-fund @fortawesome/fontawesome-pro@7.3.1",
    "preview": "vite preview",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/ e2e/",
    "test": "run-s lint test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:integration": "playwright test -c playwright.integration.config.js",
    "generate:images": "node scripts/generate-images.mjs"
  },
  "dependencies": {
    "@sentry/vue": "10.63.0",
    "@unhead/vue": "3.1.7",
    "axios": "1.20.0",
    "gsap": "3.15.0",
    "pinia": "3.0.4",
    "vee-validate": "4.15.1",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "5.1.0",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/eslint-plugin": "1.6.21",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.69.0",
    "eslint-plugin-playwright": "2.10.5",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "msw": "2.14.6",
    "npm-run-all2": "9.0.2",
    "oxlint": "1.69.0",
    "prettier": "3.8.4",
    "sass": "1.101.0",
    "vite": "8.1.6",
    "vite-plugin-vue-devtools": "8.1.5",
    "vitest": "4.1.12",
    "vue-eslint-parser": "10.4.1"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "glob": "14.0.3"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
