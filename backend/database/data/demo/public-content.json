      "sections": [
        {
          "key": "overview",
          "type": "rich_text",
          "icon": "fa-solid fa-clipboard-check",
          "title": {
            "ar": "التقييم المعتمد",
            "en": "Accredited assessment"
          },
          "subtitle": {
            "ar": "تقييم رسمي قائم على الشواهد يمنح جهتك درجة موثوقة.",
            "en": "An official evidence-based assessment that gives your entity a trusted score."
          },
          "description": {
            "ar": "ترفع الجهة شواهدها، ويراجعها مقيّم مختص وفق نموذج التميز المؤسسي، ثم تصدر الدرجة النهائية والتقرير التعقيبي.",
