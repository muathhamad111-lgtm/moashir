{
  "pages": {
    "accredited_intro": {
      "title": {
        "ar": "التقييم المعتمد",
        "en": "Accredited assessment"
      },
      "sections": [
        {
          "key": "overview",
          "type": "rich_text",
          "icon": "fa-solid fa-clipboard-check",
          "title": {
            "ar": "التقييم المعتمد",
            "en": "Accredited assessment"
          },
          "subtitle": {
            "ar": "تقييم رسمي قائم على الشواهد يمنح جهتك درجة موثوقة.",
            "en": "An official evidence-based assessment that gives your entity a trusted score."
          },
          "description": {
            "ar": "ترفع الجهة شواهدها، ويراجعها مقيّم مختص وفق نموذج التميز المؤسسي، ثم تصدر الدرجة النهائية والتقرير التعقيبي.",
            "en": "The entity uploads its evidence, a specialist assessor reviews it against the institutional excellence model, and the final score and feedback report are then issued."
          }
        },
        {
          "key": "benefits",
          "type": "faq",
          "icon": "fa-solid fa-star",
          "title": {
            "ar": "لماذا نوصي بالتقييم المعتمد؟",
            "en": "Why we recommend the accredited assessment"
          },
          "items": [
            {
              "icon": "fa-solid fa-file-shield",
              "title": {
                "ar": "مراجعة الشواهد من مقيّم مختص",
                "en": "Evidence review by a specialist assessor"
              },
              "description": {
                "ar": "قراءة موضوعية لشواهد الجهة وفق النموذج المعتمد.",
                "en": "An objective reading of the entity's evidence against the approved model."
              }
            },
            {
              "icon": "fa-solid fa-comments",
              "title": {
                "ar": "تقرير تعقيبي مفصل",
                "en": "Detailed feedback report"
              },
              "description": {
                "ar": "نقاط القوة وفرص التحسين لكل معيار فرعي.",
                "en": "Strengths and improvement opportunities for every sub-criterion."
              }
            },
            {
              "icon": "fa-solid fa-briefcase",
              "title": {
                "ar": "الوصول إلى حقيبة التميز السريع",
                "en": "Access to the Quick Excellence Kit"
              },
              "description": {
                "ar": "بعد صدور النتيجة يمكن للجهة البدء برحلة التحسين.",
                "en": "Once the result is issued the entity can start its improvement journey."
              }
            }
          ]
        },
        {
          "key": "pricing",
          "type": "pricing_box",
          "icon": "fa-solid fa-receipt",
          "title": {
            "ar": "أكمل الدفع",
            "en": "Complete payment"
          },
          "cta_label": {
            "ar": "ادفع وابدأ التقييم",
            "en": "Pay and start the assessment"
          },
          "cta_url": "/assessment/accredited"
        }
      ]
    },
    "advanced_intro": {
      "title": {
        "ar": "التقييم المتقدم",
        "en": "Advanced assessment"
      },
      "sections": [
        {
          "key": "overview",
          "type": "rich_text",
          "icon": "fa-solid fa-trophy",
          "title": {
            "ar": "التقييم المتقدم وجائزة التميز",
            "en": "The advanced assessment and the excellence award"
          },
          "description": {
            "ar": "تتنافس الجهات المؤهلة خلال دورة سنوية محددة المواعيد عبر التقييم الأولي ثم الفرز ثم مرحلة تقييم اللجنة، وتعلن النتائج بعد اعتمادها.",
            "en": "Eligible entities compete during a time-bound annual cycle through the initial assessment, filtering and the committee assessment stage; results are announced once approved."
          }
        },
        {
          "key": "cycle",
          "type": "cycle_box",
          "icon": "fa-solid fa-calendar-days",
          "title": {
            "ar": "الدورة الحالية",
            "en": "Current cycle"
          },
          "description": {
            "ar": "تعرض مواعيد الدورة وشروط المشاركة من إعدادات الدورة المعتمدة.",
            "en": "The cycle dates and entry conditions come from the approved cycle settings."
          }
        },
        {
          "key": "winners",
          "type": "winners",
          "icon": "fa-solid fa-award",
          "title": {
            "ar": "الفائزون في الدورة السابقة",
            "en": "Winners of the previous cycle"
          },
          "items": [
            {
              "icon": "fa-solid fa-award",
              "title": {
