server {
    listen 80;
    server_name {{DOMAIN}};
    server_tokens off;

    access_log {{NGINX_LOG_DIR}}/{{ENVIRONMENT}}.access.log moashir_privacy;
    error_log {{NGINX_LOG_DIR}}/{{ENVIRONMENT}}.error.log warn;

    location ^~ /.well-known/acme-challenge/ {
        root {{ACME_ROOT}};
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 404;
    }
}
