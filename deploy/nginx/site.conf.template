server {
    listen 80;
    server_name {{DOMAIN}};
    server_tokens off;

    access_log {{NGINX_LOG_DIR}}/{{ENVIRONMENT}}.access.log moashir_privacy;
    error_log {{NGINX_LOG_DIR}}/{{ENVIRONMENT}}.error.log warn;

    location ^~ /.well-known/acme-challenge/ {
        root {{ACME_ROOT}};
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name {{DOMAIN}};
    server_tokens off;
    charset utf-8;

    ssl_certificate /etc/letsencrypt/live/{{CERT_NAME}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{CERT_NAME}}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    ssl_conf_command Ciphersuites TLS_AES_256_GCM_SHA384:TLS_AES_128_GCM_SHA256;
    ssl_prefer_server_ciphers off;
    ssl_ecdh_curve prime256v1:secp384r1;
    ssl_session_timeout 1d;
    ssl_session_cache shared:moashir_tls:10m;
    ssl_session_tickets off;

    access_log {{NGINX_LOG_DIR}}/{{ENVIRONMENT}}.access.log moashir_privacy;
    error_log {{NGINX_LOG_DIR}}/{{ENVIRONMENT}}.error.log warn;

    root {{ENV_DIR}}/current/frontend;
    index index.html;
    client_max_body_size {{STATIC_BODY_LIMIT}};

    gzip on;
    gzip_types text/css application/javascript image/svg+xml;

    location ^~ /api/ {
        client_max_body_size {{API_BODY_LIMIT}};
        error_page 413 @moashir_request_too_large;
        include /etc/nginx/snippets/moashir-{{ENVIRONMENT}}-laravel.conf;

        location ~ ^/api/v1/(?:assessments/[^/]+/evidence|finance/payments/[^/]+/refunds|payments)$ {
            client_max_body_size {{EVIDENCE_BODY_LIMIT}};
            include /etc/nginx/snippets/moashir-{{ENVIRONMENT}}-laravel.conf;
        }

        location ~ ^/api/v1/admin/(?:content|kpis)/images$ {
            client_max_body_size {{PUBLIC_IMAGE_BODY_LIMIT}};
            include /etc/nginx/snippets/moashir-{{ENVIRONMENT}}-laravel.conf;
        }

        location = /api/v1/entities/me/logo {
            client_max_body_size {{ENTITY_LOGO_BODY_LIMIT}};
            include /etc/nginx/snippets/moashir-{{ENVIRONMENT}}-laravel.conf;
        }

        location = /api/v1/settings/branding/logo {
            client_max_body_size {{BRANDING_LOGO_BODY_LIMIT}};
            include /etc/nginx/snippets/moashir-{{ENVIRONMENT}}-laravel.conf;
        }
    }

    location @moashir_request_too_large {
        default_type application/json;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "no-store" always;
        return 413 $moashir_request_too_large;
    }

    location ^~ /sanctum/ {
        include /etc/nginx/snippets/moashir-{{ENVIRONMENT}}-laravel.conf;
    }

    location = /.well-known/apple-developer-merchantid-domain-association {
        include /etc/nginx/snippets/moashir-{{ENVIRONMENT}}-laravel.conf;
    }

    location ^~ /assets/ {
        include /etc/nginx/snippets/moashir-spa-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/moashir-spa-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location ~ /\. {
        return 404;
    }

    location / {
        include /etc/nginx/snippets/moashir-spa-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
