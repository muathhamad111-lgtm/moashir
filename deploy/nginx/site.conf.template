server {
    listen 80;
    server_name {{DOMAIN}};
    server_tokens off;

    access_log /var/log/nginx/moashir-{{ENVIRONMENT}}.access.log moashir_privacy;
    error_log /var/log/nginx/moashir-{{ENVIRONMENT}}.error.log warn;

    location ^~ /.well-known/acme-challenge/ {
        root {{ACME_ROOT}};
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name {{DOMAIN}};
    server_tokens off;
    charset utf-8;

    ssl_certificate /etc/letsencrypt/live/{{CERT_NAME}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{CERT_NAME}}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_ecdh_curve prime256v1:secp384r1;
    ssl_session_timeout 1d;
    ssl_session_cache shared:moashir_tls:10m;
    ssl_session_tickets off;

    access_log /var/log/nginx/moashir-{{ENVIRONMENT}}.access.log moashir_privacy;
    error_log /var/log/nginx/moashir-{{ENVIRONMENT}}.error.log warn;

    root {{ENV_DIR}}/current/frontend;
    index index.html;
    client_max_body_size 2m;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml;

    location ^~ /api/ {
        include /etc/nginx/snippets/moashir-{{ENVIRONMENT}}-laravel.conf;

        location ~ ^/api/v1/(assessments/[^/]+/evidence|finance/payments/[^/]+/refunds)$ {
            client_max_body_size {{UPLOAD_LIMIT}};
            include /etc/nginx/snippets/moashir-{{ENVIRONMENT}}-laravel.conf;
        }
    }

    location ^~ /sanctum/ {
        include /etc/nginx/snippets/moashir-{{ENVIRONMENT}}-laravel.conf;
    }

    location = /.well-known/apple-developer-merchantid-domain-association {
        include /etc/nginx/snippets/moashir-{{ENVIRONMENT}}-laravel.conf;
    }

    location ^~ /assets/ {
        include /etc/nginx/snippets/moashir-spa-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/moashir-spa-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location ~ /\. {
        return 404;
    }

    location / {
        include /etc/nginx/snippets/moashir-spa-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
