[moashir-{{ENVIRONMENT}}]
user = {{APP_USER}}
group = {{APP_USER}}

listen = {{FPM_SOCKET}}
listen.owner = {{APP_USER}}
listen.group = {{WEB_GROUP}}
listen.mode = 0660

pm = ondemand
pm.max_children = {{FPM_MAX_CHILDREN}}
pm.process_idle_timeout = 20s
pm.max_requests = 500

request_terminate_timeout = 120s
request_slowlog_timeout = 10s
slowlog = {{LOG_DIR}}/php-fpm-slow.log
catch_workers_output = no
security.limit_extensions = .php
chdir = /

env[TMPDIR] = {{ENV_DIR}}/shared/tmp

php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
php_admin_value[error_log] = {{LOG_DIR}}/php-fpm-error.log
php_admin_value[memory_limit] = 256M
php_admin_value[max_execution_time] = 120
php_admin_value[upload_max_filesize] = {{UPLOAD_LIMIT_PHP}}
php_admin_value[post_max_size] = {{POST_LIMIT_PHP}}
php_admin_value[upload_tmp_dir] = {{ENV_DIR}}/shared/tmp
php_admin_value[sys_temp_dir] = {{ENV_DIR}}/shared/tmp
php_admin_flag[allow_url_include] = off
