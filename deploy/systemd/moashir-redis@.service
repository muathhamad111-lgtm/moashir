[Unit]
Description=Moashir Redis for the %i environment (unix socket only)
After=local-fs.target
Documentation=man:redis-server(1)

[Service]
Type=simple
User=moashir-%i
Group=moashir-%i
ExecStart=/usr/bin/redis-server /etc/moashir-redis/%i.conf
RuntimeDirectory=moashir-redis-%i
RuntimeDirectoryMode=0750
StateDirectory=moashir-redis-%i
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2
TimeoutStopSec=60
LimitNOFILE=10032
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
